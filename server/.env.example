# Credentials and actual deployment addresses only. Never commit the real .env.
# Ports, database names, images, models, and feature flags are configured directly
# in the selected docker-compose*.yaml file, without .env overrides.

# Database address and credentials.
# Default Compose: postgres. Host database: host.docker.internal.
# Database port and names are configured in Compose, not here.
POSTGRES_HOST=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Model API credentials and actual workspace/region endpoint.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://YOUR_WORKSPACE.cn-beijing.maas.aliyuncs.com/api/v1
OPENAI_API_KEY=
# OPENAI_BASE_URL=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# Authentication secrets. Generate JWT_SECRET with: openssl rand -hex 48
ADMIN_API_KEY=
JWT_SECRET=

# Actual public origins, including reverse proxy URLs if used.
# These override the safe localhost defaults in Compose.
DASHBOARD_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8888
